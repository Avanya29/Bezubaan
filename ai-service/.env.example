# ============================================
# Bezubaan AI Service — Environment Variables
# ============================================
# Copy this file to .env
# DO NOT commit .env to version control.
# ============================================

# --- Service ---
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# --- Provider ---
# Options: mock (default for dev/test)
# Future: openai, gemini, anthropic (UNKNOWN — REQUIRES DECISION Q14/Q15)
AI_PROVIDER=mock

# --- LLM API Key (only needed when AI_PROVIDER != mock) ---
# LLM_API_KEY=<your-api-key>

# --- Timeouts ---
AI_PROVIDER_TIMEOUT_SECONDS=30

# --- Logging ---
LOG_LEVEL=INFO
