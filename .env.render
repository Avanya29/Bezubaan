# Render Environment Variables Guide
# Copy and paste these into your Render Dashboard when deploying

# ==========================================
# NESTJS BACKEND (Web Service)
# ==========================================
# Database Connection (PostgreSQL)
# Get this from your Render Postgres instance -> "Internal Database URL"
DATABASE_URL="postgres://user:pass@hostname/dbname"

# Redis Connection
# Get this from your Render Redis instance -> "Internal Connection String"
REDIS_URL="redis://user:pass@hostname:6379"

# RabbitMQ Connection (CloudAMQP)
# Get this from your free CloudAMQP (Little Lemur) dashboard
RABBITMQ_URL=amqps://gcyqmnen:rTyzK_TWixmbu60pFL48Yf1qzsdyqeA8@duck.lmq.cloudamqp.com/gcyqmnen

# JWT Secrets (Generate your own random strings)
JWT_SECRET="generate-a-secure-random-string-here"
JWT_REFRESH_SECRET="generate-another-secure-random-string-here"

# Google OAuth (For Google Sign-In)
# Get these from your Google Cloud Console
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://bezubaan-api.onrender.com/api/auth/google/callback"

# AI Service Connection
# Since both are on Render, use the internal URL of the AI Service if possible,
# or the public URL of the AI service (e.g., https://bezubaan-ai.onrender.com)
AI_SERVICE_URL="https://bezubaan-ai.onrender.com"

# ==========================================
# AI SERVICE (FastAPI) (Web Service)
# ==========================================
# RabbitMQ Connection (CloudAMQP)
# Must match the one used in NestJS
RABBITMQ_URL="amqps://user:pass@hostname/vhost"

# Provider selection ('gemini' or 'groq')
AI_PROVIDER="gemini"

# API Keys (You only need the one for the provider you selected)
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
